# =============================================================================
# MEME SCALPER AI PRO v2.0.0 — Environment Variables
# =============================================================================
# Untuk Replit: tambahkan semua nilai ke Secrets (Tools → Secrets)
# Untuk lokal : copy file ini ke .env dan isi nilainya
# JANGAN pernah commit file .env atau private key ke repository!
# =============================================================================

# ─── DASHBOARD LOGIN (WAJIB) ──────────────────────────────────────────────────
# Username untuk login ke web dashboard (default: admin)
BOT_USERNAME=admin
# Password untuk login ke web dashboard — WAJIB DIGANTI dari default!
BOT_PASSWORD=ganti_password_kuat_ini

# ─── WALLET (Wajib untuk Live Trading) ───────────────────────────────────────
# Alamat wallet Base Network kamu
WALLET_ADDRESS=0x...your_wallet_address...
# Private key wallet — RAHASIAKAN! Jangan pernah share ke siapapun
WALLET_PRIVATE_KEY=your_private_key_here_without_0x_prefix

# ─── AI PROVIDER: GEMINI (Primary) ───────────────────────────────────────────
# Bobot voting: 30% | Model: gemini-1.5-flash | Free tier tersedia
# Daftar di: https://aistudio.google.com/app/apikey
#
# OPSI 1 — Satu key:
GEMINI_API_KEY=your_gemini_api_key_here
#
# OPSI 2 — Multi-key rotasi (pisahkan dengan koma, tanpa spasi):
# GEMINI_API_KEY=key1_here,key2_here,key3_here
#
# OPSI 3 — Key terpisah per secret (bisa dikombinasi dengan OPSI 1):
# GEMINI_API_KEY_2=your_second_gemini_key
# GEMINI_API_KEY_3=your_third_gemini_key
# GEMINI_API_KEY_4=your_fourth_gemini_key
# (didukung hingga GEMINI_API_KEY_9)
#
# Sistem rotasi otomatis: key yang kena 429 disuspend 60 detik, lalu coba key berikutnya.
# Jika semua Gemini key habis → Groq + Huangfing otomatis jadi backup dengan bobot ditingkatkan.

# ─── AI PROVIDER: GROQ (Backup #1) ───────────────────────────────────────────
# Bobot voting: 30% | Model: llama-3.1-8b-instant | Free tier tersedia
# Daftar di: https://console.groq.com
# Aktif sebagai backup otomatis ketika semua Gemini key rate-limited.
GROQ_API_KEY=your_groq_api_key_here

# ─── AI PROVIDER: OPENROUTER (Opsional) ──────────────────────────────────────
# Bobot voting: 20% | Model: meta-llama/llama-3.2-3b-instruct:free
# Daftar di: https://openrouter.ai — tersedia model gratis (suffix :free)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ─── AI PROVIDER: TOGETHER AI (Opsional) ─────────────────────────────────────
# Bobot voting: 15% | Model: meta-llama/Llama-3.2-3B-Instruct-Turbo
# Daftar di: https://together.ai — $1 kredit gratis untuk akun baru
TOGETHER_API_KEY=your_together_api_key_here

# ─── AI PROVIDER: HUANGFING (Backup #2) ──────────────────────────────────────
# Bobot voting: 5% | Model: huangfing-pro
# Aktif sebagai backup ketika semua Gemini key rate-limited.
HUANGFING_API_KEY=your_huangfing_api_key_here
HUANGFING_BASE_URL=https://api.huangfing.ai/v1

# ─── TELEGRAM NOTIFIKASI (Opsional) ──────────────────────────────────────────
# Alert untuk setiap trade, circuit breaker, start/stop bot.
# Cara membuat bot: chat @BotFather di Telegram → /newbot
# Cara dapat Chat ID: chat @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── BOT BEHAVIOUR ────────────────────────────────────────────────────────────
# true = bot langsung jalan dalam mode simulasi saat server start
AUTO_START=true
# Port server web dashboard (default 5000)
PORT=5000
# Level log: debug | info | warn | error
LOG_LEVEL=debug

# ─── RPC BASE NETWORK (Sudah ada default di config.json) ─────────────────────
# Endpoint ini dipakai config.json, tidak perlu diubah kecuali ada masalah koneksi.
# BASE_RPC_PRIMARY=https://mainnet.base.org
# BASE_RPC_BACKUP_1=https://base.llamarpc.com
# BASE_RPC_BACKUP_2=https://rpc.base.org
