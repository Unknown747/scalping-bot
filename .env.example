# =============================================================================
# MEME SCALPER AI PRO v2.0.0 — Environment Variables
# =============================================================================
# Untuk Replit : tambahkan semua nilai ke Tools → Secrets
# Untuk lokal  : copy file ini ke .env dan isi nilainya
# JANGAN pernah commit file .env atau private key ke repository!
# =============================================================================

# ─── DASHBOARD LOGIN (WAJIB) ──────────────────────────────────────────────────
# Username untuk login ke web dashboard (default: admin)
BOT_USERNAME=admin
# Password untuk login ke web dashboard — WAJIB DIGANTI dari default!
BOT_PASSWORD=ganti_password_kuat_ini

# ─── WALLET (Wajib untuk Live Trading) ───────────────────────────────────────
# Alamat wallet Base Network kamu
WALLET_ADDRESS=0x...your_wallet_address...
# Private key wallet — RAHASIAKAN! Jangan pernah share ke siapapun
WALLET_PRIVATE_KEY=your_private_key_here_without_0x_prefix

# =============================================================================
# AI PROVIDERS — Semua tersedia tier GRATIS
# =============================================================================

# ─── GEMINI (Primary AI — Bobot 30%) ─────────────────────────────────────────
# Tier gratis: 1.500 request/hari, 15 RPM — cukup untuk scalping aktif
# Cara dapat API key GRATIS:
#   1. Buka https://aistudio.google.com/app/apikey
#   2. Login dengan akun Google
#   3. Klik "Create API key" → pilih project → Copy key
#   4. Tidak perlu kartu kredit!
#
# OPSI 1 — Satu key:
GEMINI_API_KEY=your_gemini_api_key_here
#
# OPSI 2 — Multi-key rotasi (pisahkan dengan koma, tanpa spasi):
# GEMINI_API_KEY=key1_here,key2_here,key3_here
#
# OPSI 3 — Key terpisah per secret (bisa dikombinasi dengan OPSI 1):
# GEMINI_API_KEY_2=your_second_gemini_key
# GEMINI_API_KEY_3=your_third_gemini_key
# GEMINI_API_KEY_4=your_fourth_gemini_key
# (didukung hingga GEMINI_API_KEY_9)
#
# Tip: Buat 3-5 akun Google berbeda untuk mendapat rate limit 3-5x lipat.

# ─── GROQ (Backup AI #1 — Bobot 30%) ─────────────────────────────────────────
# Tier gratis: 14.400 request/hari (6.000 token/menit) — sangat cepat
# Cara dapat API key GRATIS:
#   1. Buka https://console.groq.com
#   2. Daftar / login (bisa pakai Google/GitHub)
#   3. Klik "API Keys" di sidebar → "Create API Key" → Copy
#   4. Tidak perlu kartu kredit!
GROQ_API_KEY=your_groq_api_key_here

# ─── OPENROUTER (Opsional — Bobot 20%) ────────────────────────────────────────
# Tier gratis: tersedia puluhan model dengan suffix ":free" tanpa biaya
# Cara dapat API key GRATIS:
#   1. Buka https://openrouter.ai
#   2. Klik "Sign In" → daftar dengan email / Google / GitHub
#   3. Buka https://openrouter.ai/keys → "Create Key" → Copy
#   4. Model gratis yang digunakan: meta-llama/llama-3.2-3b-instruct:free
#   5. Tidak perlu kartu kredit! (ada kredit $1 gratis untuk akun baru)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ─── TOGETHER AI (Opsional — Bobot 15%) ───────────────────────────────────────
# $1 kredit gratis saat daftar, model Llama 3.2 3B sangat murah (~$0.06/1M token)
# Cara dapat API key GRATIS:
#   1. Buka https://api.together.ai
#   2. Daftar dengan email
#   3. Dashboard → "API Keys" → "Create new key" → Copy
#   4. $1 kredit otomatis diberikan saat registrasi
TOGETHER_API_KEY=your_together_api_key_here

# ─── HUANGFING (Backup AI #2 — Bobot 5%) ─────────────────────────────────────
# Aktif otomatis sebagai backup ketika Gemini rate-limited
# Cara dapat API key GRATIS:
#   1. Buka https://huangfing.ai atau endpoint yang dikonfigurasi
#   2. Daftar akun → buka API settings → generate key
HUANGFING_API_KEY=your_huangfing_api_key_here
HUANGFING_BASE_URL=https://api.huangfing.ai/v1

# =============================================================================
# ON-CHAIN SECURITY — GoPlus API (100% GRATIS, TANPA API KEY!)
# =============================================================================
# GoPlus Security digunakan untuk:
#   ✅ Cek dev holding % (filter > 1%)
#   ✅ Cek top-10 holders concentration (filter > 25%)
#   ✅ Cek buy/sell tax (filter > 5%)
#   ✅ Deteksi honeypot otomatis
#   ✅ Deteksi mintable token
#   ✅ Hitung jumlah unique wallet holder (proxy "smart money")
#
# TIDAK PERLU API KEY — GoPlus gratis tanpa registrasi apapun!
# Bot otomatis memanggil: https://api.gopluslabs.io/api/v1/token_security/8453
# Semua setting GoPlus dikonfigurasi di config.json → "goplus_filter"

# =============================================================================
# DATA PASAR — Semua GRATIS tanpa API key
# =============================================================================
# GeckoTerminal  → https://api.geckoterminal.com  — gratis, tanpa key
# DexScreener    → https://api.dexscreener.com    — gratis, tanpa key

# =============================================================================
# NOTIFIKASI TELEGRAM (Opsional — 100% Gratis)
# =============================================================================
# Cara setup Telegram Bot GRATIS:
#   1. Buka Telegram → cari @BotFather → kirim /start
#   2. Kirim /newbot → isi nama bot → isi username bot (harus diakhiri "bot")
#   3. BotFather akan memberi token — copy ke TELEGRAM_BOT_TOKEN
#   4. Buka @userinfobot di Telegram → kirim /start → copy Chat ID
#   5. Atau: cari grup/channel kamu → forward pesan ke @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =============================================================================
# BOT BEHAVIOUR
# =============================================================================
# true = bot langsung jalan dalam mode simulasi saat server start
AUTO_START=true
# Port server web dashboard (default 5000)
PORT=5000
# Level log: debug | info | warn | error
LOG_LEVEL=debug

# =============================================================================
# RPC BASE NETWORK (Optional Override)
# =============================================================================
# Endpoint sudah ada default di config.json.
# Uncomment hanya jika ingin override dengan endpoint custom / berbayar.
# BASE_RPC_PRIMARY=https://mainnet.base.org
# BASE_RPC_BACKUP_1=https://base.llamarpc.com
# BASE_RPC_BACKUP_2=https://rpc.base.org
#
# Untuk performa lebih baik (opsional, ada free tier):
# Alchemy  → https://dashboard.alchemy.com  (300M compute unit/bulan gratis)
# Infura   → https://infura.io              (100K request/hari gratis)
# QuickNode→ https://quicknode.com          (10M credit gratis)
