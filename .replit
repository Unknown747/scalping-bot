modules = ["nodejs-20", "bash", "web", "go-1.25"]

[deployment]
router = "application"
deploymentTarget = "vm"
run = ["bash", "-c", "PORT=8080 NODE_ENV=production node --enable-source-maps ./artifacts/api-server/dist/index.mjs"]
build = ["bash", "-c", "pnpm --filter @workspace/scalping-dashboard run build && pnpm --filter @workspace/api-server run build"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true
integrations = ["javascript_gemini_ai_integrations:2.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 18432
externalPort = 3000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
LOG_LEVEL = "debug"
NODE_ENV = "production"
MEV_PROTECTION_RPC = "https://mev-blocker.drpc.org"
