# ─────────────────────────────────────────────────────────────────────────────
# BASE SCALPER — Environment Variables
# Salin file ini ke .env dan isi nilainya. JANGAN commit .env ke git!
# cp .env.example .env && nano .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production

# ── Autentikasi Dashboard (WAJIB) ────────────────────────────────────────────
# Generate: openssl rand -hex 32
SESSION_SECRET=ganti_dengan_string_acak_64_karakter
DASHBOARD_PASSWORD=password_dashboard_anda_yang_kuat

# ── Wallet Base Network (WAJIB untuk live trading) ───────────────────────────
# JANGAN PERNAH bagikan PRIVATE_KEY ke siapapun!
PRIVATE_KEY=0x_kunci_privat_wallet_base_network_anda
WALLET_ADDRESS=0x_alamat_wallet_base_network_anda

# ── RPC Base Network ─────────────────────────────────────────────────────────
# Rekomendasi: Alchemy (gratis 300M req/bulan) → https://alchemy.com
# Alternatif: Infura → https://infura.io | QuickNode → https://quicknode.com
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# MEV Protection (opsional, anti-sandwich attack)
# MEV_PROTECTION_RPC=https://rpc.flashbots.net/fast

# ── Database (opsional) ──────────────────────────────────────────────────────
# Default: ./scalping.db | Docker: /data/scalping.db (sudah diset di compose)
# SQLITE_PATH=/data/scalping.db

# ── AI Filter (opsional) ─────────────────────────────────────────────────────
# Di Replit: env var sudah tersedia otomatis lewat AI Integrations.
# Di VPS: isi dengan key dari provider langsung.
#
# Provider 1: Google Gemini (rekomendasi utama)
# Buat key gratis di https://aistudio.google.com/app/apikey
AI_INTEGRATIONS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
AI_INTEGRATIONS_GEMINI_API_KEY=AIza_your_google_ai_studio_key

# Provider 2: OpenRouter (fallback Groq/HuggingFace)
# Buat key di https://openrouter.ai/keys (ada free tier)
AI_INTEGRATIONS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_INTEGRATIONS_OPENROUTER_API_KEY=sk-or-your_openrouter_key

# ── Telegram Bot (opsional) ──────────────────────────────────────────────────
# Buat bot: chat @BotFather di Telegram → /newbot
# Chat ID: chat @userinfobot atau @getidsbot
# TELEGRAM_BOT_TOKEN=1234567890:ABCdef...
# TELEGRAM_CHAT_ID=-1001234567890

# ── Logging ──────────────────────────────────────────────────────────────────
# Level: debug | info | warn | error
LOG_LEVEL=info
