# ─────────────────────────────────────────────────────────────────────────────
# BASE SCALPER — Environment Variables
# Salin file ini ke .env dan isi nilainya. JANGAN commit .env ke git!
#   cp artifacts/api-server/.env.example artifacts/api-server/.env
#   nano artifacts/api-server/.env
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production

# ── Autentikasi Dashboard (WAJIB) ────────────────────────────────────────────
# Generate SESSION_SECRET: openssl rand -hex 32
SESSION_SECRET=ganti_dengan_string_acak_minimal_32_karakter
DASHBOARD_PASSWORD=password_dashboard_anda_yang_kuat

# ── Wallet Base Network (WAJIB untuk live trading) ───────────────────────────
# PERINGATAN: Gunakan wallet BARU khusus bot — jangan pakai wallet utama!
# JANGAN PERNAH commit atau share PRIVATE_KEY ke siapapun!
PRIVATE_KEY=0x_kunci_privat_wallet_base_network_anda
WALLET_ADDRESS=0x_alamat_wallet_base_network_anda

# ── RPC Base Network ─────────────────────────────────────────────────────────
# Alchemy (gratis 300M req/bulan): https://alchemy.com
# Infura: https://infura.io | QuickNode: https://quicknode.com
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ── MEV Protection (anti sandwich attack & front-running) ────────────────────
MEV_PROTECTION_RPC=https://mev-blocker.drpc.org
MEV_PROTECTION_RPC_BACKUP=https://rpc.flashbots.net/fast

# ── AI Filter — Parallel Consensus (semua provider dijalankan bersamaan) ──────
#
# Sistem parallel: semua provider yang aktif dijalankan BERSAMAAN per analisis.
#   Keputusan diambil secara majority vote — butuh ceil(n/2) provider setuju BUY.
#   Contoh 3 provider: minimal 2 dari 3 harus BUY → keputusan = BUY.
# Jika salah satu provider gagal → tetap jalan dengan yang berhasil respond.
# Minimal 1 provider harus diset agar AI Filter aktif.
# Disarankan isi ketiganya untuk consensus yang lebih akurat dan tidak ada downtime.
#
# Provider 1: Google Gemini — Deep Analysis (kualitas terbaik)
# Gratis: 1500 req/hari, 15 req/menit
# Daftar key: https://aistudio.google.com/app/apikey
AI_INTEGRATIONS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
AI_INTEGRATIONS_GEMINI_API_KEY=AIza_your_google_ai_studio_key
#
# Provider 2: Groq — Speed Decision (ultra-cepat, latensi <1 detik)
# Gratis: generous rate limits (14400 req/hari untuk Llama 3.1-8b)
# Daftar key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key
#
# Provider 3: HuggingFace — Tiebreaker / Backup
# Gratis: rate-limited, tidak perlu kartu kredit
# Daftar key: https://huggingface.co/settings/tokens (pilih "Read" token)
HUGGINGFACE_API_KEY=hf_your_huggingface_token

# ── Telegram Bot (opsional) ──────────────────────────────────────────────────
# Buat bot via @BotFather di Telegram → /newbot
# Chat ID: cek via @userinfobot atau @getidsbot
# TELEGRAM_BOT_TOKEN=1234567890:ABCdef...
# TELEGRAM_CHAT_ID=-1001234567890

# ── Logging ──────────────────────────────────────────────────────────────────
# Level: debug | info | warn | error
LOG_LEVEL=info
