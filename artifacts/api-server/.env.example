# ─────────────────────────────────────────────────────────────
# BASE SCALPER — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# Server
PORT=8080
NODE_ENV=production

# Authentication (REQUIRED)
SESSION_SECRET=ganti_dengan_string_acak_64_karakter_atau_lebih
DASHBOARD_PASSWORD=ganti_password_dashboard_anda

# Wallet (REQUIRED for live trading)
PRIVATE_KEY=0x_kunci_privat_wallet_base_network
WALLET_ADDRESS=0x_alamat_wallet_anda

# Base Network RPC (Recommended: gunakan Alchemy/Infura, bukan public RPC)
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
MEV_PROTECTION_RPC=https://rpc.flashbots.net/fast   # optional, anti-sandwich

# Database (optional, default: ./scalping.db)
# SQLITE_PATH=/data/scalping.db

# AI Filter — Replit AI Integrations
# Di Replit: auto-set. Di VPS: isi manual dari dashboard.replit.com/ai-integrations
AI_INTEGRATIONS_GEMINI_BASE_URL=https://api.replit.com/v1/ai/gemini
AI_INTEGRATIONS_GEMINI_API_KEY=your_replit_gemini_key

AI_INTEGRATIONS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_INTEGRATIONS_OPENROUTER_API_KEY=your_openrouter_key

# Logging (optional: debug, info, warn, error)
LOG_LEVEL=info
