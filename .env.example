# ============================================
# MEME SCALPER BOT - ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your keys
# ============================================

# -------------------- MULTI RPC (Base Network) --------------------
BASE_RPC_1=https://mainnet.base.org
BASE_RPC_2=https://base.llamarpc.com
BASE_RPC_3=https://rpc.base.org
BASE_RPC_4=https://base.blockpi.network/v1/rpc/public
BASE_RPC_5=https://1rpc.io/base
BASE_RPC_6=https://base.drpc.org
BASE_RPC_7=https://base.meowrpc.com
BASE_RPC_8=https://base.publicnode.com

BASE_WS_1=wss://mainnet.base.org/ws
BASE_WS_2=wss://base.drpc.org
BASE_CHAIN_ID=8453

# -------------------- WALLET --------------------
WALLET_PRIVATE_KEY=your_private_key_here
WALLET_ADDRESS=0x...

# -------------------- AI PROVIDERS --------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

HUANGFING_API_KEY=your_huangfing_api_key_here
HUANGFING_BASE_URL=https://api.huangfing.ai/v1
HUANGFING_MODEL=huangfing-pro

# -------------------- MARKET DATA --------------------
GECKO_TERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2
DEXSCREENER_API_URL=https://api.dexscreener.com/latest

# -------------------- MEV PROTECTION --------------------
FLASHBOTS_RELAY=https://relay.flashbots.net
FLASHBOTS_RELAY_2=https://bloxroute.max-profit.blxrbdn.com
PRIVATE_MEMPOOL_ENABLED=true
RANDOM_DELAY_MS_MIN=100
RANDOM_DELAY_MS_MAX=500

# -------------------- TELEGRAM (Optional) --------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
